# ---------------------------------------------------------------------------
# GamaTech Systems — environment configuration
# Copy to `.env.local` (git-ignored) and fill in real values.
# NEVER commit a file containing real secrets.
# ---------------------------------------------------------------------------

# Public canonical origin. Must be https:// in production (used for canonical
# tags, sitemap.xml, robots.txt, OpenGraph URLs and secure-cookie detection).
NEXT_PUBLIC_SITE_URL=https://www.gamatechsystems.com

# Absolute or project-relative path to the SQLite database file.
# Keep this OUTSIDE your web root. Default: ./data/gamatech.db
DATABASE_PATH=./data/gamatech.db

# 64-hex-character secret used to hash session tokens and IP addresses at rest.
# Generate with:  openssl rand -hex 32
# Rotating this value invalidates all sessions (safe, logs everyone out).
APP_SECRET=replace-me-with-openssl-rand-hex-32

# Optional: comma-separated extra origins allowed to POST (Server Actions).
# Leave empty unless the site is served from more than one hostname.
ALLOWED_ORIGINS=

# Optional: set to "1" to trust X-Forwarded-For (only behind a proxy you control,
# e.g. Nginx, Cloudflare, Vercel). Leaving it off avoids IP spoofing of rate limits.
TRUST_PROXY=0
